# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=payload-cms-starter-kit

# Payload secret for authentication and encryption.
# Replace this placeholder. Production requires at least 32 unique characters.
PAYLOAD_SECRET=YOUR_PAYLOAD_CMS_SECRET_HERE

# Optional Shadcn Blocks tooling key; not used by the CMS runtime
SHADCNBLOCKS_API_KEY=SHADCNBLOCKS_API_KEY_HERE

# Email configuration
EMAIL_PROVIDER=none
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=Your Website
RESEND_OVERRIDE_TO_EMAIL=you@example.com

# Local development uses the repository's local media directory.
MEDIA_PROVIDER=localDisk
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible media storage for hosted uploads (Cloudflare R2 example).
# Set MEDIA_PROVIDER=s3 and configure every required S3 value in hosted environments.
# S3_BUCKET=snmih-media
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key
# S3_PUBLIC_URL=https://assets.snmih.tanish.im
# R2 does not support S3 object ACLs. Use none to omit the ACL header.
# S3_ACL=none
# S3_FORCE_PATH_STYLE=true
# Keep server-side uploads during initial R2 cutover. Enabling client uploads requires
# a narrowly scoped PUT CORS rule for every allowed Admin origin.
# S3_CLIENT_UPLOADS=false

# Optional: secure token for the on-demand media reconciliation route.
# Use this with POST /api/operations/media/reconcile-storage
# MEDIA_RECONCILE_TOKEN=change-me

# Production database backup automation. Prefer GitHub environment secrets instead of local values.
# PROD_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# R2_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BACKUP_ACCESS_KEY_ID=your_bucket_scoped_r2_access_key
# R2_BACKUP_SECRET_ACCESS_KEY=your_bucket_scoped_r2_secret_key
