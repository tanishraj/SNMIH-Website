{
  "name": "payload-cms-next-tailwind-shadcn-starter-kit",
  "version": "1.0.0",
  "description": "Editorial marketing CMS starter built with Payload CMS and Next.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "backup:prod-db": "tsx scripts/backup-prod-db.ts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:block-thumbnails": "tsx scripts/generate-block-thumbnails.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "project-context:check": "node .agents/skills/project-context/scripts/check-project-context.mjs",
    "project-context:update": "node .agents/skills/project-context/scripts/update-project-context.mjs",
    "report:permissions-migration": "tsx scripts/report-two-role-feature-migration.mjs",
    "export:db": "node scripts/export-db.mjs",
    "migrate:offices": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-office-locations.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:project-context": "vitest run --config ./vitest.config.mts tests/int/project-context-lib.int.spec.ts tests/int/project-context-repository.int.spec.ts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:ssg": "tsx tests/helpers/ssgSmokeTest.ts",
    "test:two-factor": "playwright test --config=playwright.two-factor.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@hookform/resolvers": "^5.4.3",
    "@next/third-parties": "16.2.10",
    "@payloadcms/db-mongodb": "3.87.0",
    "@payloadcms/email-resend": "3.85.2",
    "@payloadcms/live-preview-react": "3.85.2",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@payloadcms/storage-s3": "3.90.0",
    "@payloadcms/ui": "3.85.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "graphql": "^16.8.1",
    "lucide-react": "^1.23.0",
    "mongodb-memory-server": "^11.2.0",
    "next": "16.3.8",
    "otpauth": "^9.5.2",
    "payload": "3.90.0",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.23",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "swiper": "^14.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "shadcn": "^4.16.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
